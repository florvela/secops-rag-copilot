# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Paths
CONFIG_PATH=config/config.json
LOG_DIR=logs

# Local LLM (Ollama) used by the agents
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: only needed if you swap the heuristic injection detector
# for the gated Meta Prompt Guard 2 model from Hugging Face.
HF_TOKEN=
