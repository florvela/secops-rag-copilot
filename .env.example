# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Paths
CONFIG_PATH=config/config.json
LOG_DIR=logs

# LLM backend for the agents: "native" (Ollama via HTTP) or "langchain".
# "langchain" requires requirements-langchain.txt installed.
LLM_BACKEND=native
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: only needed if you swap the heuristic injection detector
# for the gated Meta Prompt Guard 2 model from Hugging Face.
HF_TOKEN=
